              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('student registration succeeds without returning a password hash', function () {",
                  "  pm.response.to.have.status(201);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.eql(true);",
                  "  pm.expect(body.data.user.role).to.eql('STUDENT');",
                  "  pm.expect(body.data.user).not.to.have.property('password');",
