              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('assigned staff resolves the complaint and records history', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.eql(true);",
                  "  pm.expect(body.data.status).to.eql('RESOLVED');",
                  "  pm.expect(body.data.history[body.data.history.length - 1].previous_status).to.eql('IN_PROGRESS');",
                  "  pm.expect(body.data.history[body.data.history.length - 1].new_status).to.eql('RESOLVED');",
                  "});"
                ]
              }
            }
          ]
        }
